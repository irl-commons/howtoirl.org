---
// Skip link, the drawings the page uses, the IRL Commons sites bar and the top bar
// with the site navigation. German pages keep the English navigation, marked as such.
import Marks from './Marks.astro';
import Illustrations from './Illustrations.astro';
const {page} = Astro.props;
const de = page.lang === 'de';
const en = de ? 'en' : undefined;
// The page's own item is the current page; a page under an item marks that item.
// Apps and services and Contact are in the footer, so the bar fits on a phone.
const current = href => href === page.name ? 'page' : href === page.section ? 'true' : undefined;
---
<a class="skip" href="#main">{de ? 'Zum Inhalt' : 'Skip to content'}</a>

<Marks />
{page.illustrations && <Illustrations set={page.illustrations} />}
<nav class="family" lang={en} aria-label="IRL Commons sites">
  <div class="wrap">
    <ul><li><a href="https://howtoirl.org/" aria-current="true"><svg aria-hidden="true"><use href="#mk-howtoirl"/></svg>How to IRL</a></li><li><a href="https://irlcommons.org/"><svg aria-hidden="true"><use href="#mk-irlcommons"/></svg>IRL Commons</a></li></ul>
  </div>
</nav>

<header class="top">
  <div class="wrap">
    <a class="brand" href="index.html" aria-label={de ? 'How to IRL, zur Startseite' : 'How to IRL, home'}>
      <svg aria-hidden="true"><use href="#mark"/></svg>
      How to IRL
    </a>
    <span class="beta"><button type="button" class="beta-badge" popovertarget="beta-tip" aria-describedby="beta-tip">Beta</button><span class="beta-tip" id="beta-tip" popover role="tooltip">{de
      ? <Fragment>Diese Seite ist neu und noch nicht fertig. <a href="contact.html" hreflang="en">Sagen Sie mir, was nicht stimmt</a></Fragment>
      : <Fragment>This site is new and not complete. Something wrong? <a href="contact.html">Let us know</a></Fragment>}</span></span>
    <nav class="site-nav" aria-label="Site" lang={en}>
      <ul>
        <li><a href="index.html" data-label="Get started" aria-current={current('index.html')}>Get started</a></li>
        <li><a href="index.html#grp-live-but-something-s-wrong" data-label="Fix">Fix</a></li>
        <li><a href="help.html#guides" data-label="Guides" aria-current={current('help.html')}>Guides</a></li>
        <li><a href="glossary.html" data-label="Glossary" aria-current={current('glossary.html')}>Glossary</a></li>
      </ul>
    </nav>
    <button type="button" class="theme-toggle" id="theme-toggle" data-mode="auto" aria-label="Colour theme: auto" hidden><svg class="ti ti-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none"/></svg><svg class="ti ti-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg><svg class="ti ti-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg><span class="theme-tip" aria-hidden="true">Theme: auto</span></button>
  </div>
</header>
