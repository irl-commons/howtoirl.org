---
// Title, description, canonical address and link preview tags. Every page has a share image, 1200 by 630:
// scripts/share.py picks it and hashes it into .generated/share.json, scripts/share-images.mjs draws it.
import site from '../../site.json';
import share from '../../.generated/share.json';
const {page} = Astro.props;
const url = `https://${site.domain}/${page.name === 'index.html' ? '' : page.name}`;
const file = share.pages[page.name];
const image = `https://${site.domain}/${file}?v=${share.images[file].v}`;
const alt = share.images[file].alt;
const other = {en: 'de', de: 'en'}[page.lang];
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{page.title}</title>
<meta name="description" content={page.description}>
<meta name="referrer" content="no-referrer">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="canonical" href={url}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={page.title.replace(` · ${site.name}`, '')}>
<meta property="og:description" content={page.description}>
<meta property="og:url" content={url}>
<meta property="og:locale" content={page.lang === 'de' ? 'de_DE' : 'en_GB'}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content={String(share.size[0])}>
<meta property="og:image:height" content={String(share.size[1])}>
<meta property="og:image:alt" content={alt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={image}>
<meta name="twitter:image:alt" content={alt}>
{page.alternate && <Fragment><link rel="alternate" hreflang={page.lang} href={page.name}>
<link rel="alternate" hreflang={other} href={page.alternate}></Fragment>}
<link rel="preload" href="assets/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="assets/style.css">
{page.stylesheet && <link rel="stylesheet" href={page.stylesheet}>}
