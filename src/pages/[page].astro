---
import Layout from '../layouts/Layout.astro';
import {pages} from '../page-meta.mjs';
import rendered from '../../.generated/content.json';
export function getStaticPaths() { return pages.filter(p => p.name !== 'index.html').map(page => ({params: {page: page.name.replace(/\.html$/, '')}, props: {page}})); }
const {page} = Astro.props;
---
<Layout page={page}><Fragment set:html={rendered[page.name]} /></Layout>
